{
  "env": {
    "PC_RESUMEN": "1"
  },
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/pc/hooks/evento.py\" SessionStart", "timeout": 5}]}
    ],
    "PreToolUse": [
      {"matcher": "Bash|Agent|Task|AskUserQuestion",
       "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/pc/hooks/evento.py\" PreToolUse", "timeout": 5}]}
    ],
    "PostToolUse": [
      {"matcher": "Bash|Agent|Task|AskUserQuestion",
       "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/pc/hooks/evento.py\" PostToolUse", "timeout": 5}]}
    ],
    "SubagentStart": [
      {"hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/pc/hooks/evento.py\" SubagentStart", "timeout": 5}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/pc/hooks/evento.py\" SubagentStop", "timeout": 5}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/pc/hooks/evento.py\" Stop", "timeout": 5}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/pc/hooks/evento.py\" SessionEnd", "timeout": 5}]}
    ]
  }
}
